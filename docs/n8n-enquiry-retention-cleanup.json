      "name": "Get chat enquiries"
    },
    {
      "parameters": {
        "jsCode": "// Keep only rows created more than 24 calendar months ago (Privacy Policy s9)\nconst cutoff = new Date();\ncutoff.setMonth(cutoff.getMonth() - 24);\n\nconst old = $input.all()\n  .map((i) => i.json)\n  .filter((r) => {\n    const t = Date.parse(r.createdAt ?? r.created_at ?? '');\n    return !Number.isNaN(t) && t < cutoff.getTime();\n  });\n\nreturn old.map((r) => ({\n  json: {\n    id: r.id ?? r.rowId ?? '',\n    createdAt: r.createdAt ?? r.created_at ?? '',\n    table: 'site_enquiries',\n  },\n}));"
      },

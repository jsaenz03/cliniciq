    {
      "parameters": {
        "jsCode": "// The model is told to reply with pure JSON; tolerate fences/prose.\n// Safety net: never send an email without a working unsubscribe link.\nconst raw = items[0].json.output ?? items[0].json.text ?? '';\nconst text = typeof raw === 'string' ? raw : JSON.stringify(raw);\nlet out;\ntry {\n  const m = text.match(/\\{[\\s\\S]*\\}/);\n  out = JSON.parse(m ? m[0] : text);\n} catch {\n  throw new Error('Newsletter AI output was not valid JSON: ' + text.slice(0, 200));\n}\nconst subject = String(out.subject || 'ClinicIQ Solutions update').trim();\nlet html = String(out.html || '').trim();\nif (!html) throw new Error('Newsletter AI output had no HTML');\nif (!html.includes('{{UNSUB_URL}}')) {\n  html += '\\n<p style=\"margin:24px 0 0;font-size:12px;color:#6b7280;\">You are receiving this because you subscribed at cliniciq.com.au · <a href=\"{{UNSUB_URL}}\">Unsubscribe</a></p>';\n}\nreturn [{ json: { subject, html } }];"
      },

      "parameters": {
        "jsCode": "// Confirmation page for the unsubscribe link.\nconst q = $('unsubscribe').first().json.query || {};\nconst html = `<!DOCTYPE html>\n<html lang=\"en-AU\">\n<head><meta charset=\"UTF-8\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" /><title>Unsubscribed | ClinicIQ Solutions</title></head>\n<body style=\"margin:0;padding:0;background:#F5F1E6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;\">\n  <div style=\"max-width:520px;margin:64px auto;background:#ffffff;border-radius:12px;padding:36px 32px;text-align:center;border:1px solid #e5e7eb;\">\n    <img src=\"https://downloads.cliniciq.com.au/icons/cliniciq-logo.png\" alt=\"ClinicIQ Solutions\" width=\"130\" style=\"display:block;margin:0 auto 18px;\" />\n    <h1 style=\"margin:0 0 10px;font-size:22px;color:#2C4A3C;\">You're unsubscribed</h1>\n    <p style=\"margin:0 0 18px;font-size:15px;line-height:1.6;color:#374151;\">${q.email ? 'The email <strong>' + q.email + '</strong> will no longer receive the ClinicIQ newsletter.' : 'This email will no longer receive the ClinicIQ newsletter.'}</p>\n    <p style=\"margin:0;font-size:13px;color:#6b7280;\">Changed your mind? You can subscribe again any time at <a href=\"https://cliniciq.com.au\" style=\"color:#2C4A3C;\">cliniciq.com.au</a>.</p>\n  </div>\n</body>\n</html>`;\nreturn [{ json: { html } }];"
      },
